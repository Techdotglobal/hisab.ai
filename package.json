    "test:quickbooks-snapshot": "tsx --test --experimental-test-module-mocks tests/integrations/quickbooks-snapshot-model.test.ts tests/integrations/quickbooks-snapshot-storage.test.ts tests/integrations/quickbooks-snapshot-storage-listing.test.ts tests/integrations/quickbooks-snapshot-validation.test.ts tests/integrations/quickbooks-snapshot-wiring.test.ts tests/integrations/quickbooks-snapshot-extractor.test.ts tests/integrations/quickbooks-snapshot-migration-source.test.ts tests/integrations/quickbooks-snapshot-batching.test.ts tests/integrations/quickbooks-snapshot-page-window.test.ts tests/integrations/quickbooks-provider-partition-regression.test.ts tests/integrations/quickbooks-snapshot-lifecycle.test.ts tests/integrations/quickbooks-snapshot-continuation.test.ts tests/integrations/quickbooks-snapshot-attachment-budget.test.ts tests/integrations/quickbooks-snapshot-attachment-ledger.test.ts tests/integrations/quickbooks-snapshot-attachment-capture.test.ts tests/integrations/quickbooks-snapshot-attachment-pagination.test.ts tests/integrations/quickbooks-inventory-adjustment-materialize.test.ts",
    "test:quickbooks-certification": "tsx --test tests/integrations/quickbooks-certification.test.ts tests/integrations/quickbooks-cutoff-reconciliation.test.ts tests/integrations/quickbooks-multicurrency-certification.test.ts tests/integrations/quickbooks-payment-relationships.test.ts tests/integrations/quickbooks-deposit-materialization.test.ts tests/integrations/quickbooks-vendor-credit-materialization.test.ts tests/integrations/quickbooks-sales-receipt-materialization.test.ts tests/integrations/quickbooks-retained-earnings-certification.test.ts tests/integrations/quickbooks-production-hardening.test.ts && tsx --test tests/integrations/payment-allocations-migration.test.ts",
    "test:cost-centers": "npx tsx --test tests/cost-centers/typed-imports.test.ts tests/cost-centers/import-errors.test.ts tests/cost-centers/product-catalog.test.ts tests/cost-centers/project-upsert.test.ts tests/cost-centers/api-serialize.test.ts",
    "test:production": "npx tsx --test tests/security/production.test.ts tests/ops/reliability.test.ts tests/workflows/business-flows.test.ts tests/accounting/core-coverage.test.ts",
    "generate:test-data": "node scripts/import-export/generate-test-data.mjs && node scripts/import-export/generate-edge-cases.mjs",
    "zatca:sandbox": "npx tsx -r dotenv/config -r ./scripts/zatca/setup-server-only.cjs scripts/zatca/run-zatca-sandbox.mjs",
    "zatca:verify": "npx tsx -r dotenv/config -r ./scripts/zatca/setup-server-only.cjs scripts/zatca/zatca-phase7-verify.mjs",
    "db:test-customer-vendor-write": "npx tsx -r dotenv/config -r ./scripts/zatca/setup-server-only.cjs scripts/db/test-customer-vendor-write.ts",
    "start": "next start",
    "worker": "tsx -r dotenv/config -r ./scripts/zatca/setup-server-only.cjs worker/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
