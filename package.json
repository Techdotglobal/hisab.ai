{
  "name": "hisab-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:seed": "npx tsx -r dotenv/config scripts/qa/qa-seed.mjs",
    "qa:seed": "npx tsx -r dotenv/config scripts/qa/qa-seed.mjs",
    "test:zatca": "npx --yes tsx --test tests/zatca/onboarding.test.ts tests/zatca/classification.test.ts tests/zatca/vat-rounding.test.ts tests/zatca/monetary-pipeline.test.ts tests/zatca/profile-id.test.ts",
    "test:import-export": "npx tsx --test tests/import-export/framework.test.ts tests/import-export/performance.test.ts tests/import-export/official-templates.test.ts tests/import-export/quickbooks-source.test.ts",
    "test:accounting": "npx tsx --test tests/accounting/engine.test.ts tests/accounting/enterprise.test.ts tests/accounting/core-coverage.test.ts tests/currency/multicurrency-tax.test.ts tests/inventory/enterprise.test.ts tests/workflow/engine.test.ts tests/reporting/enterprise.test.ts tests/platform/services.test.ts tests/security/production.test.ts tests/ops/reliability.test.ts tests/workflows/business-flows.test.ts tests/invoices/creation-enhancements.test.ts",
    "test:invoices": "npx tsx --test tests/invoices/creation-enhancements.test.ts",
    "test:invoice-pdf": "npx tsx -r ./scripts/zatca/setup-server-only.cjs --test tests/invoices/pdf-layout.test.ts",
    "test:document-numbering": "npx tsx --test tests/document-numbering/format.test.ts",
    "test:integrations": "npx tsx --test tests/integrations/accounting-integrations.test.ts",
